{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wzry-img-proxy",
  "main": "worker.mjs",
  "account_id": "537d52cefb1159c81f64f9155fda9964",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["global_fetch_private_origin"],
  "cache": { "enabled": true, "cross_version_cache": true },
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "PublicCache": { "type": "worker", "cache": { "enabled": true } }
  },
  "observability": { "enabled": true, "head_sampling_rate": 1, "redact_query_string": true },
  "routes": [
    { "pattern": "skinsdata.top/api/user*", "zone_name": "skinsdata.top" },
    { "pattern": "www.skinsdata.top/api/user*", "zone_name": "skinsdata.top" },
    { "pattern": "skinsdata.top/img/*", "zone_name": "skinsdata.top" },
    { "pattern": "www.skinsdata.top/img/*", "zone_name": "skinsdata.top" },
    { "pattern": "skinsdata.top/api/skins*", "zone_name": "skinsdata.top" },
    { "pattern": "www.skinsdata.top/api/skins*", "zone_name": "skinsdata.top" },
    { "pattern": "skinsdata.top/api/heroes*", "zone_name": "skinsdata.top" },
    { "pattern": "www.skinsdata.top/api/heroes*", "zone_name": "skinsdata.top" },
    { "pattern": "skinsdata.top/api/resources*", "zone_name": "skinsdata.top" },
    { "pattern": "www.skinsdata.top/api/resources*", "zone_name": "skinsdata.top" }
  ]
}
